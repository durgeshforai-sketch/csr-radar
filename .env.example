# Copy to .env.local and fill in. Never commit .env.local.

# --- Neon (Postgres) ---
DATABASE_URL=

# --- Gemini Flash (all AI tasks), via the OpenRouter gateway ---
# Only "google/" models; every request is pinned to Google's own providers (google-vertex / google-ai-studio)
OPENROUTER_API_KEY=
GEMINI_MODEL=google/gemini-3.7-flash

# --- Resend (Monday digest email) ---
RESEND_API_KEY=
# onboarding@resend.dev can only send to the Resend account's own address until a domain is verified
EMAIL_FROM=CSR Radar <onboarding@resend.dev>
# Fallback recipient if none are set in Settings
DIGEST_RECIPIENT=

# --- App ---
# Single shared login for Ananya's team
DASHBOARD_PASSWORD=
# Vercel Cron sends this as "Authorization: Bearer …" to /api/cron/digest
CRON_SECRET=
APP_BASE_URL=http://localhost:3000
